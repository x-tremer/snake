def ocultar_mensajes():
    mensaje.clear()

def actualizar_comida_visual():
    comida.color(comidas[comida_actual]["color"])
    hoja.color(comidas[comida_actual]["hoja"])

def mostrar_objetos_juego():
    cabeza1.showturtle()
    if modo == 2:
        cabeza2.showturtle()
    comida.showturtle()
    hoja.showturtle()

def ocultar_objetos_juego():
    cabeza1.hideturtle()
    cabeza2.hideturtle()
    comida.hideturtle()
    hoja.hideturtle()
    for s in segmentos1:
        s.hideturtle()
    for s in segmentos2:
        s.hideturtle()
    for o in obstaculos:
        o.hideturtle()

def mostrar_segmentos_y_obstaculos():
    for s in segmentos1:
        s.showturtle()
    for s in segmentos2:
        s.showturtle()
    for o in obstaculos:
        o.showturtle()

def posicion_libre():
    while True:
        x = random.randint(-320, 320)
        y = random.randint(-320, 320)
        x = round(x / 20) * 20
        y = round(y / 20) * 20

        ocupadas = [(cabeza1.xcor(), cabeza1.ycor()), (cabeza2.xcor(), cabeza2.ycor())]
        ocupadas += [(s.xcor(), s.ycor()) for s in segmentos1]
        ocupadas += [(s.xcor(), s.ycor()) for s in segmentos2]
        ocupadas += [(o.xcor(), o.ycor()) for o in obstaculos]

        if (x, y) not in ocupadas:
            return x, y

def colocar_comida():
    x, y = posicion_libre()
    comida.goto(x, y)
    hoja.goto(x + 8, y + 12)

def crear_obstaculos():
    global obstaculos

    for o in obstaculos:
        o.goto(1000, 1000)
        o.hideturtle()
    obstaculos.clear()

    posiciones = []
    nombre_mapa = mapas[mapa_actual]["nombre"]

    if nombre_mapa == "Clásico":
        posiciones = []

    elif nombre_mapa == "Columnas":
        for y in range(-120, 140, 20):
            posiciones.append((-140, y))
            posiciones.append((140, y))

    elif nombre_mapa == "Cruz":
        for x in range(-140, 160, 20):
            posiciones.append((x, 0))
        for y in range(-140, 160, 20):
            posiciones.append((0, y))

    elif nombre_mapa == "Fortaleza":
        for x in range(-220, 240, 20):
            if x not in (-20, 0, 20):
                posiciones.append((x, -180))
                posiciones.append((x, 180))
        for y in range(-140, 160, 20):
            posiciones.append((-220, y))
            posiciones.append((220, y))

    if nivel >= 3 and nombre_mapa != "Clásico":
        for x in range(-80, 100, 20):
            if x != 0:
                posiciones.append((x, 120))
                posiciones.append((x, -120))

    for pos in posiciones:
        o = turtle.Turtle()
        o.speed(0)
        o.shape("square")
        o.color("gray")
        o.penup()
        o.goto(pos)
        o.hideturtle()
        obstaculos.append(o)

def crear_segmento(color):
    s = turtle.Turtle()
    s.speed(0)
    s.shape("square")
    s.color(color)
    s.penup()
    s.hideturtle()
    return s

def actualizar_skin():
    cabeza1.color(skins[skin_actual]["cabeza"])
    for s in segmentos1:
        s.color(skins[skin_actual]["cuerpo"])

def reiniciar_juego(nuevo_modo):
    global estado, modo, delay, nivel, puntaje1, puntaje2, ganador

    modo = nuevo_modo
    delay = DELAY_INICIAL
    nivel = 1
    puntaje1 = 0
    puntaje2 = 0
    ganador = ""

    cabeza1.goto(-100, 0)
    cabeza1.direction = "stop"

    cabeza2.goto(100, 0)
    cabeza2.direction = "stop"

    if modo == 2:
        estado = "jugando2"
    else:
        estado = "jugando1"

    for s in segmentos1:
        s.goto(1000, 1000)
        s.hideturtle()
    for s in segmentos2:
        s.goto(1000, 1000)
        s.hideturtle()

    segmentos1.clear()
    segmentos2.clear()

    crear_obstaculos()
    actualizar_skin()
    actualizar_comida_visual()
    colocar_comida()

    mostrar_objetos_juego()
    mostrar_segmentos_y_obstaculos()

    actualizar_marcador()
    ocultar_mensajes()

def subir_nivel():
    global nivel, delay
    total = puntaje1 + puntaje2 if modo == 2 else puntaje1
    nuevo_nivel = total // 8 + 1
    if nuevo_nivel != nivel:
        nivel = nuevo_nivel
        delay = max(0.05, DELAY_INICIAL - (nivel - 1) * 0.01)
        crear_obstaculos()
        colocar_comida()
        mostrar_segmentos_y_obstaculos()

def mostrar_pausa():
    mensaje.clear()
    dibujar_texto_centrado("PAUSA", 20, 28, "yellow")
    dibujar_texto_centrado("Pulsa P para continuar", -20, 16, "white")

def mostrar_game_over():
    mensaje.clear()
    if modo == 1:
        dibujar_texto_centrado("GAME OVER", 40, 28, "red")
        dibujar_texto_centrado("ENTER = volver a jugar 1P", 0, 16)
