        dibujar_texto_centrado("2 = jugar 2P", -50, 16)
        dibujar_texto_centrado("M = menú", -80, 16)

def ir_menu():
    global estado
    estado = "menu"

    cabeza1.goto(-100, 0)
    cabeza1.direction = "stop"

    cabeza2.goto(100, 0)
    cabeza2.direction = "stop"

    for s in segmentos1:
        s.goto(1000, 1000)
        s.hideturtle()
    for s in segmentos2:
        s.goto(1000, 1000)
        s.hideturtle()

    segmentos1.clear()
    segmentos2.clear()

    for o in obstaculos:
        o.goto(1000, 1000)
        o.hideturtle()
    obstaculos.clear()

    ocultar_objetos_juego()
    actualizar_skin()
    actualizar_comida_visual()
    actualizar_marcador()
    mostrar_menu()

def salir():
    wn.bye()

# =========================
# MOVIMIENTO
# =========================
def mover_serpiente(cabeza):
    x = cabeza.xcor()
    y = cabeza.ycor()

    if cabeza.direction == "Up":
        cabeza.sety(y + MOVIMIENTO)
    elif cabeza.direction == "Down":
        cabeza.sety(y - MOVIMIENTO)
    elif cabeza.direction == "Left":
        cabeza.setx(x - MOVIMIENTO)
    elif cabeza.direction == "Right":
        cabeza.setx(x + MOVIMIENTO)

def mover_segmentos(cabeza, segmentos):
    for i in range(len(segmentos) - 1, 0, -1):
        x = segmentos[i - 1].xcor()
        y = segmentos[i - 1].ycor()
        segmentos[i].goto(x, y)

    if len(segmentos) > 0:
        segmentos[0].goto(cabeza.xcor(), cabeza.ycor())

# =========================
# CONTROLES J1
# =========================
def arriba():
    if estado in ("jugando1", "jugando2") and cabeza1.direction != "Down":
        cabeza1.direction = "Up"

def abajo():
    if estado in ("jugando1", "jugando2") and cabeza1.direction != "Up":
        cabeza1.direction = "Down"

def izquierda():
    if estado in ("jugando1", "jugando2") and cabeza1.direction != "Right":
        cabeza1.direction = "Left"

def derecha():
    if estado in ("jugando1", "jugando2") and cabeza1.direction != "Left":
        cabeza1.direction = "Right"

# =========================
# CONTROLES J2
# =========================
def w():
    if estado == "jugando2" and cabeza2.direction != "Down":
        cabeza2.direction = "Up"

def s():
    if estado == "jugando2" and cabeza2.direction != "Up":
        cabeza2.direction = "Down"

def a():
    if estado == "jugando2" and cabeza2.direction != "Right":
        cabeza2.direction = "Left"

def d():
    if estado == "jugando2" and cabeza2.direction != "Left":
        cabeza2.direction = "Right"

# =========================
# MENÚ Y OPCIONES
# =========================
def pausar():
    global estado
    if estado in ("jugando1", "jugando2"):
        estado = "pausa"
        mostrar_pausa()
    elif estado == "pausa":
        estado = "jugando2" if modo == 2 else "jugando1"
        ocultar_mensajes()

def cambiar_skin():
    global skin_actual
    if estado == "menu":
        skin_actual = (skin_actual + 1) % len(skins)
        actualizar_skin()
        mostrar_menu()

def cambiar_mapa():
    global mapa_actual
    if estado == "menu":
        mapa_actual = (mapa_actual + 1) % len(mapas)
        mostrar_menu()

def cambiar_comida():
    global comida_actual
    if estado == "menu":
        comida_actual = (comida_actual + 1) % len(comidas)
        actualizar_comida_visual()
        mostrar_menu()

def abrir_online():
    global estado
    if estado == "menu":
        estado = "online"
        ocultar_objetos_juego()
        mostrar_online()

def iniciar_1p():
    reiniciar_juego(1)

def iniciar_2p():
    reiniciar_juego(2)

# =========================
# COLISIONES
# =========================
def toca_borde(cabeza):
    return cabeza.xcor() > 330 or cabeza.xcor() < -330 or cabeza.ycor() > 330 or cabeza.ycor() < -330

def toca_obstaculo(cabeza):
    for o in obstaculos:
        if o.distance(cabeza) < 10:
            return True
    return False

def toca_cuerpo(cabeza, segmentos):
    for s in segmentos:
        if s.distance(cabeza) < 10:
            return True
    return False

def terminar_1p():
    global estado, record
    estado = "gameover1"
    if puntaje1 > record:
        record = puntaje1
        guardar_record()
    actualizar_marcador()
    mostrar_game_over()

def terminar_2p(texto_ganador):
    global estado, record, ganador
    estado = "gameover2"
    ganador = texto_ganador
    mejor = max(puntaje1, puntaje2)
    if mejor > record:
        record = mejor
        guardar_record()
    actualizar_marcador()
    mostrar_game_over()

def sumar_puntos_j1():
    global puntaje1, record
    puntos = comidas[comida_actual]["puntos"]
    puntaje1 += puntos
    if puntaje1 > record:
        record = puntaje1

def sumar_puntos_j2():
    global puntaje2, record
    puntos = comidas[comida_actual]["puntos"]
    puntaje2 += puntos
    if puntaje2 > record:
        record = puntaje2

# =========================
# TECLAS
# =========================
wn.listen()
wn.onkeypress(arriba, "Up")
wn.onkeypress(abajo, "Down")
wn.onkeypress(izquierda, "Left")
wn.onkeypress(derecha, "Right")

wn.onkeypress(w, "w")
wn.onkeypress(s, "s")
wn.onkeypress(a, "a")
wn.onkeypress(d, "d")

wn.onkeypress(pausar, "p")
wn.onkeypress(cambiar_skin, "k")
wn.onkeypress(cambiar_mapa, "j")
wn.onkeypress(cambiar_comida, "c")
wn.onkeypress(abrir_online, "o")
wn.onkeypress(iniciar_1p, "1")
wn.onkeypress(iniciar_2p, "2")
wn.onkeypress(iniciar_1p, "Return")
wn.onkeypress(ir_menu, "m")
wn.onkeypress(salir, "q")

# =========================
# INICIO
# =========================
cargar_record()
actualizar_skin()
actualizar_comida_visual()
actualizar_marcador()
ocultar_objetos_juego()
mostrar_menu()

# =========================
# LOOP PRINCIPAL
# =========================
while True:
    wn.update()

    for p in particulas:
        y = p.ycor() + 0.35
        if y > 350:
            p.goto(random.randint(-340, 340), -350)
        else:
            p.sety(y)

    if estado == "jugando1":
        mostrar_segmentos_y_obstaculos()
        mover_segmentos(cabeza1, segmentos1)
        mover_serpiente(cabeza1)

        if toca_borde(cabeza1) or toca_obstaculo(cabeza1) or toca_cuerpo(cabeza1, segmentos1):
            terminar_1p()

        if cabeza1.distance(comida) < 15:
            colocar_comida()
            nuevo = crear_segmento(skins[skin_actual]["cuerpo"])
            nuevo.showturtle()
            segmentos1.append(nuevo)
            sumar_puntos_j1()
            subir_nivel()
            actualizar_marcador()

    elif estado == "jugando2":
        mostrar_segmentos_y_obstaculos()
        mover_segmentos(cabeza1, segmentos1)
        mover_segmentos(cabeza2, segmentos2)

        mover_serpiente(cabeza1)
        mover_serpiente(cabeza2)

        j1_pierde = (
            toca_borde(cabeza1) or
            toca_obstaculo(cabeza1) or
            toca_cuerpo(cabeza1, segmentos1) or
            toca_cuerpo(cabeza1, segmentos2) or
            cabeza1.distance(cabeza2) < 10
        )

        j2_pierde = (
            toca_borde(cabeza2) or
            toca_obstaculo(cabeza2) or
            toca_cuerpo(cabeza2, segmentos2) or
            toca_cuerpo(cabeza2, segmentos1) or
            cabeza2.distance(cabeza1) < 10
        )

        if j1_pierde and j2_pierde:
            terminar_2p("Empate")
        elif j1_pierde:
            terminar_2p("Gana Jugador 2")
        elif j2_pierde:
            terminar_2p("Gana Jugador 1")

        if estado == "jugando2":
            if cabeza1.distance(comida) < 15:
                colocar_comida()
                nuevo = crear_segmento(skins[skin_actual]["cuerpo"])
                nuevo.showturtle()
                segmentos1.append(nuevo)
                sumar_puntos_j1()
                subir_nivel()
                actualizar_marcador()
            elif cabeza2.distance(comida) < 15:
                colocar_comida()
                nuevo = crear_segmento("cyan")
                nuevo.showturtle()
                segmentos2.append(nuevo)
                sumar_puntos_j2()
                subir_nivel()
                actualizar_marcador()

    time.sleep(delay if estado in ("jugando1", "jugando2") else 0.03)